$md = array( 31, 0, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 );




function siYoon($sy){

	if($sy%4 != 0) return 0;
	if($sy%100 != 0) return 1;
	if($sy%400 != 0) return 0;

	return 1;
}

function sol2lun($y, $m, $d)

{

	global $kk,$md;
	

	$td1 = 672069;
	settype($td1,"integer");
	$sy = $y;

	if(siYoon($sy)) $md[1]=29;
	else $md[1] = 28;
	
	$sm = $m;
	$sd = $d;
	$td2 = ($sy-1) * 365 + ($sy-1)/4 - ($sy-1)/100 + ($sy-1)/400 + $sd; 
	settype($td2,"integer");

	for($i=0; $i<$sm-1; $i++){
		$td2 += $md[$i];
	}

	$td = $td2 - $td1 + 1;

	for($i=0; $i<=$sy-1841; $i++) {
		$dt[$i] = 0;
		for($j=0; $j<12; $j++) {
			switch( $kk[ $i*12 + $j] ) {
				case 1 : $mm = 29;
					     break;
				case 2 : $mm = 30;
					     break;
				case 3 : $mm = 58;   /* 29+29 */
					     break;
                			case 4 : $mm = 59;   /* 29+30 */
					     break;
                			case 5 : $mm = 59;   /* 30+29 */
					     break;
				case 6 : $mm = 60;   /* 30+30 */
					     break;
			}
			$dt[$i] += $mm;
		}
	}
	$ly = 0;
	while(1) {
		if( $td > $dt[$ly] ) {
			$td -= $dt[$ly];
			$ly++;

		} else break;
	}
	$lm = 0;
	$yoon = "";
	while(1){
		if( $kk[$ly*12+$lm] <= 2 ) {
			$mm = $kk[$ly*12+$lm] + 28;

			if( $td > $mm ) {
				$td -= $mm;
				$lm++;
			} else break;
		} else {
			switch( $kk[$ly*12+$lm] ) {
				case 3 : $m1 = 29;
					 $m2 = 29;
					 break;					
				case 4 : $m1 = 29;
					 $m2 = 30;
					 break;
				case 5 : $m1 = 30;
					 $m2 = 29;
					 break;
				case 6 : $m1 = 30;
					 $m2 = 30;
					 break;
			}
			if( $td > $m1 ) {
				$td -= $m1;
				if( $td > $m2 ) {
					$td -= $m2;
					$lm++;
				} else {
					$yoon = "YOON";
					break;
				}
			} else break;
		}
	}

	$ly += 1841;
	$lm += 1;
	$ld = $td-1;
	$w = $td2 % 7;
	$i = ($td2+4) % 10;
	$j = ($td2+2) % 12;
	$k1 = ($ly+6) % 10;
	$k2 = ($ly+8) % 12;

	$year = (int)$ly;
	$month=(int)$lm;
	$day=(int)$ld+1;
	
	return array($year,$month,$day);
}
